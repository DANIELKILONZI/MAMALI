DATABASE_URL="file:./dev.db"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_ENVIRONMENT="sandbox"
REFRESH_TOKEN_SECRET="your-refresh-secret-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="30d"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
LOG_LEVEL="info"
LOG_TO_FILE="false"
ENABLE_DB_LOGS="true"

# ── Notifications (WhatsApp + SMS) ──────────────────────────────────────────
# Set to true to enable customer notifications after order & payment events
NOTIFICATIONS_ENABLED="false"

# WhatsApp via Meta Cloud API
# Get these from https://developers.facebook.com/apps/ after creating a WhatsApp Business app
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SMS fallback via Africa's Talking
# Register at https://africastalking.com and grab your API key
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""
